<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\libs\ChargyCore.NET\ChargyCore\ChargyCore.csproj" />
    <ProjectReference Include="..\libs\CSMS\CSMS\CSMS.csproj" />
    <ProjectReference Include="..\libs\Hermod\Hermod\Hermod.csproj" />
    <ProjectReference Include="..\libs\MCP\MCP\MCP.csproj" />
    <ProjectReference Include="..\libs\Norn\Norn\Norn.csproj" />
    <ProjectReference Include="..\libs\Styx\Styx\Styx.csproj" />
    <ProjectReference Include="..\libs\WWCP_Core\WWCP_CoreData\WWCP_CoreData.csproj" />
    <ProjectReference Include="..\libs\WWCP_Core\WWCP_Core\WWCP_Core.csproj" />
    <ProjectReference Include="..\libs\WWCP_Core\WWCP_OverlayNetworking\WWCP_OverlayNetworking.csproj" />
    <ProjectReference Include="..\libs\WWCP_DatexII\WWCP_DatexII\WWCP_DatexII.csproj" />
    <ProjectReference Include="..\libs\WWCP_Node\WWCP_Node\WWCP_Node.csproj" />
    <ProjectReference Include="..\libs\WWCP_OCPP\WWCP_OCPPv1.6\WWCP_OCPPv1.6.csproj" />
    <ProjectReference Include="..\libs\WWCP_OCPP\WWCP_OCPPv1.6_CentralSystem\WWCP_OCPPv1.6_CentralSystem.csproj" />
    <ProjectReference Include="..\libs\WWCP_OCPP\WWCP_OCPPv2.1\WWCP_OCPPv2.1.csproj" />
    <ProjectReference Include="..\libs\WWCP_OCPP\WWCP_OCPPv2.1_CSMS\WWCP_OCPPv2.1_CSMS.csproj" />
    <ProjectReference Include="..\libs\WWCP_OCPP\WWCP_OCPP_Common\WWCP_OCPP_Common.csproj" />
  </ItemGroup>

  <!--
    CLI/ is the former interactive test console: a prompt that took OCPP
    commands - connections, servers, use, setDefaultRegistrationStatus - and
    sent them at a central system and a CSMS built by hand in the old
    Program.cs. It is kept because those commands are a working OCPP operator
    console and nothing else here has one, and it is excluded from the build
    because CSMSTestCLI wants an OCPP 1.6 central system node beside the 2.1
    one, and this process now builds a CSMS the way a charging station and a
    local controller are built: one OCPP 2.1 node, one HTTP server, a web
    interface in front of it.

    To go back to it, comment this line out and give CSMSTestCLI the two nodes
    it asks for.
  -->
  <ItemGroup>
    <Compile Remove="CLI\**\*.cs" />
    <None Include="CLI\**\*.cs" />
  </ItemGroup>

</Project>
